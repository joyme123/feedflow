{
  "manifest_version": 3,
  "name": "FeedFlow Cookie 同步",
  "version": "1.0.0",
  "description": "自动将浏览器中已登录的微博、X、V2EX 等信息源 Cookie 同步到 FeedFlow 桌面端",
  "permissions": ["cookies", "alarms", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FeedFlow Cookie 同步状态"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
