{
  "manifest_version": 3,
  "name": "FeedFlow",
  "version": "1.3.0",
  "description": "FeedFlow 浏览器伴侣：一键把微博、X (Twitter)、V2EX 等网站的登录 Cookie 自动同步到 FeedFlow 桌面端，免去手动复制粘贴。配合桌面 App 使用，即可在一个清爽的时间线里集中浏览你关注的所有信息源。",
  "permissions": ["cookies", "alarms", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FeedFlow"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
